# Normalize line endings: LF in the repo regardless of Windows checkout,
# so WSL/LibreLane consume identical bytes.
* text=auto

*.sh text eol=lf
*.sv text eol=lf
*.v text eol=lf
*.xdc text eol=lf
*.mem text eol=lf
*.bash text eol=lf

*.json text
*.md text
*.yml text eol=lf
*.yaml text eol=lf
*.py text

# Simulator waveform dumps are generated artifacts
*.vcd binary